# tg-agent — configuration. Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env
# Or don't fill it in by hand and run `uv run tg init` — the wizard asks only for
# what is missing and writes it here itself (`uv run tg setup` — the same for
# keys and the bot).
#
# .env holds full access to the account. It is in .gitignore and .dockerignore,
# keep the permissions at 600 and do not copy it to other machines.

# ── required ───────────────────────────────────────────────────────────────
# my.telegram.org → API development tools → create an application.
# These are the MTProto keys: without them only the Bot API is available, so
# other people's chats are invisible.
TG_API_ID=
TG_API_HASH=

# ── notification bot (needed for alerts and commands from your phone) ──────
# @BotFather → /newbot → a token like 1234567890:AA...
# Create a SEPARATE bot for the agent, do not reuse an existing one:
# the daemon hard-ignores messages from its own bot, otherwise an alert triggers
# an alert.
TG_BOT_TOKEN=

# Where to send alerts. Filled in automatically by the `tg link-bot` command
# after you press Start in the chat with the bot. This is your user id.
TG_ALERT_CHAT_ID=

# ── behaviour ──────────────────────────────────────────────────────────────
# The master write switch. 0 — the agent can only read: send/edit/delete/
# forward/mute/archive/pin return an error without reaching Telegram.
TG_ALLOW_WRITE=1

# ── audio transcription (voice messages, video notes, music, video) ────────
# Groq key: console.groq.com/keys. Without it you are left with Telegram's
# built-in transcription (voice messages and video notes only, needs Premium)
# and the local model.
GROQ_API_KEY=

# auto — Telegram → Groq → local. Can be forced: telegram, groq, local.
# TG_WHISPER_ENGINE=auto
# TG_GROQ_MODEL=whisper-large-v3-turbo
# The local model, installed via `uv sync --extra local-whisper`: on Apple
# Silicon that is mlx-whisper, on other hardware faster-whisper (the marker in
# pyproject decides on its own). Both understand the name below: for
# faster-whisper its tail is taken, large-v3-turbo.
# TG_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# A file larger than this is not sent for transcription, MB.
# TG_TRANSCRIBE_MAX_MB=24

# ── chat dossiers (tg_memory) ──────────────────────────────────────────────
# The key of the model that writes the dossiers. This is the only place in the
# agent where the contents of a conversation leave the machine — without the key
# a dossier update simply refuses to run, everything else keeps working as before.
OPENAI_API_KEY=

# The model and the API address. base_url can be changed to any compatible
# service, including a local one — then the conversation never leaves the machine.
# TG_MEMORY_MODEL=
# TG_MEMORY_BASE_URL=
# How many messages to take on the first pass and how many at most per update.
# TG_MEMORY_FIRST=
# TG_MEMORY_MAX_NEW=
# TG_MEMORY_MAX_CHARS=
# TG_MEMORY_TIMEOUT=

# ── paths (mostly needed for docker) ───────────────────────────────────────
# Where the session, logs, rules and downloads live. By default ./data next to
# the code.
# TG_DATA_DIR=/data
# Where to read the .env itself from, if it is not next to the code.
# TG_ENV_FILE=/config/.env
